// Cloudflare settings: the site is plain HTML/CSS/JS, served as-is from this folder.
// Only /api/* runs code (worker.js).
{
  "name": "dukabora-tz",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // /sv/<product id> etc. = short ad links (see worker.js)
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*", "/tz/*", "/zm/*", "/lb/*", "/sv/*"] }
}
